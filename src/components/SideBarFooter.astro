    <a
        href="https://www.linkedin.com/in/amanda-lim-71881a342/"
        target="_blank"
        class="mx-3"
        aria-label="Linkedin"
        title="Linkedin"
    >
        <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            style="fill: currentColor;transform: ;msFilter:;"
            ><circle cx="4.983" cy="5.009" r="2.188"></circle><path
                d="M9.237 8.855v12.139h3.769v-6.003c0-1.584.298-3.118 2.262-3.118 1.937 0 1.961 1.811 1.961 3.218v5.904H21v-6.657c0-3.27-.704-5.783-4.526-5.783-1.835 0-3.065 1.007-3.568 1.96h-.051v-1.66H9.237zm-6.142 0H6.87v12.139H3.095z"
            ></path>
        </svg>
    </a>

    <script>
        const audio = document.getElementById('background-audio');
        const toggleBtn = document.getElementById('volume-toggle');
        audio.volume = 0.2;
        let isPlaying = false;

        const volumeOnIcon = `
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" viewBox="0 0 16 16">
                <path d="M11.536 14.01a.5.5 0 0 1-.707 0 8 8 0 0 1 0-11.314.5.5 0 1 1 .707.707 7 7 0 0 0 0 9.9.5.5 0 0 1 0 .707z"/>
                <path d="M8.707 11.293a1 1 0 0 1-1.414 0L5 9H2.5A1.5 1.5 0 0 1 1 7.5v-1A1.5 1.5 0 0 1 2.5 5H5l2.293-2.293a1 1 0 0 1 1.707.707v9a1 1 0 0 1-1.707.707z"/>
            </svg>`;

        const muteIcon = `
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" viewBox="0 0 16 16">
                <path d="M9.717 3.55A.5.5 0 0 1 10.5 4v8a.5.5 0 0 1-.783.41L6.825 10H4.5A1.5 1.5 0 0 1 3 8.5v-1A1.5 1.5 0 0 1 4.5 6h2.325l2.892-2.41z"/>
                <path fill-rule="evenodd" d="M13.646 13.354a.5.5 0 0 1-.707 0L10.5 10.914l-2.439 2.44a.5.5 0 0 1-.707-.707l2.439-2.439-2.439-2.439a.5.5 0 1 1 .707-.707l2.439 2.439 2.439-2.439a.5.5 0 1 1 .707.707L11.207 10.5l2.439 2.439a.5.5 0 0 1 0 .707z"/>
            </svg>`;

        toggleBtn.addEventListener('click', () => {
            if (isPlaying) {
                audio.pause();
                toggleBtn.innerHTML = muteIcon;
            } else {
                audio.play();
                toggleBtn.innerHTML = volumeOnIcon;
            }
            isPlaying = !isPlaying;
        });
    </script>
</div>