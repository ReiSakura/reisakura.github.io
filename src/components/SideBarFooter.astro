        href="javascript:void(0)"
        id="volume-toggle"
        class="mx-3"
        aria-label="Toggle Audio"
        title="Toggle Audio"
    >
        <!-- Initial volume icon (will toggle) -->
        <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 16 16"
