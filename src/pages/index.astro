---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
import { getCollection } from "astro:content";
import createSlug from "../lib/createSlug"
import { Image } from "astro:assets";
import backgroundImage from '~/../public/background.jpg';

const projects = (await getCollection("project")).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const last_projects = projects.slice(0, 3).reverse();
---

<BaseLayout sideBarActiveItemID="home">
  <div class="pb-12 mt-5">
    <div class="text-xl py-1">Hey there 👋</div>
    <div class="text-5xl font-bold">I'm Amanda</div>
    <div class="text-3xl py-3 font-bold">Web Designer & Creative Thinker</div>
    <div class="py-2">
      <text class="text-lg">
        With a strong eye for design and a passion for crafting seamless digital experiences, I specialize in building websites that are not only visually compelling but also highly functional. From intuitive layouts to data-driven dashboards, I love turning ideas into smart, user-focused solutions. I approach every project — whether digital, visual, or conceptual — with the mindset of an artist and the discipline of a designer. From intuitive web interfaces to thoughtfully crafted user journeys, I bring creativity, curiosity, and intentionality to everything I do.
      </text>
    </div>
  </div>

  <Image width={750} height={422} format="jpg" src={backgroundImage} alt={"bgimg"} class="w-full mb-6" />
  <hr />

  <div>
    <div class="text-3xl w-full font-bold mb-2">My last projects</div>
  </div>

  {
    last_projects.map((project) => (
      <>
        <HorizontalCard
          title={project.data.title}
          img={project.data.thumbnail}
          desc={project.data.description}
          url={"/projects/" + createSlug(project.data.title, project.slug)}
          target="_self"
          badge={project.data.badge}
        />
        <div class="divider my-0" />
      </>
    ))
  }
</BaseLayout>
