---
import BaseLayout from "../layouts/BaseLayout.astro";
import TimeLineElement from "../components/cv/TimeLine.astro";
---

<BaseLayout title="Resume" sideBarActiveItemID="cv">
  <div class="mb-5">
    <div class="text-3xl w-full font-bold">Profile</div>
  </div>

  <div class="mb-10 text-justify">
    With a strong eye for design and a passion for crafting seamless digital experiences, I specialize in building websites that are not only visually compelling but also highly functional. From intuitive layouts to data-driven dashboards, I love turning ideas into smart, user-focused solutions. I approach every project — whether digital, visual, or conceptual — with the mindset of an artist and the discipline of a designer. From intuitive web interfaces to thoughtfully crafted user journeys, I bring creativity, curiosity, and intentionality to everything I do.
  </div>

  <div class="mb-5">
    <div class="text-3xl w-full font-bold">Education</div>
  </div>

  <div class="time-line-container grid gap-4 mb-10">
    <TimeLineElement
      title="Diploma in Information Technology (C85)"
      subtitle="2022 to 2025 at Nanyang Polytechnic, Singapore"
    />
  </div>

  <div class="mb-5">
    <div class="text-3xl w-full font-bold">Experience</div>
  </div>

  <div class="time-line-container mb-10">
    <TimeLineElement
      title="Internship Student"
      subtitle="From May 2022 to Aug 2022 at Jobidk Limited, Singapore"
    >
    job description
    </TimeLineElement>
  </div>

  <div class="mb-5">
    <div class="text-3xl w-full font-bold">Certifications</div>
  </div>

  <ul class="list-disc mx-6 mb-10 grid gap-2"> 
    <!-- why did u make this clickable lol -->
    <li>
      <a href="#" target="_blank">Google Data Analytics Professional Certificate</a>
    </li>
  </ul>

  <div class="mb-5">
    <div class="text-3xl w-full font-bold">Skills</div>
  </div>

  <ul class="list-disc md:columns-5 columns-2 mx-6">
    <li>HTML, CSS, JavaScript</li>
    <li>React</li>
    <li>Node.js, Express.js</li>
    <li>Python, Flask</li>
    <li>Java</li>
    <li>Swift, SwiftUI</li>
    <li>Reality Composer Pro (RealityKit, ARKit)</li>
    <li>SQL</li>
    <li>RESTful API</li>
    <li>Git, GitHub, CI/CD</li>
    <li>Data Science, Big Data (Pandas, NumPy)</li>
  </ul>
  <button class="relative inline-flex items-center justify-center p-0.5 mb-2 me-2 overflow-hidden text-sm font-medium text-gray-900 rounded-lg group bg-gradient-to-br from-purple-600 to-blue-500 group-hover:from-cyan-500 group-hover:to-blue-500 hover:text-white dark:text-white focus:ring-4 focus:outline-none focus:ring-cyan-200 dark:focus:ring-cyan-800"
          style="position: fixed; bottom: 10%; right: 5%;">
    <span class="relative px-5 py-2.5 transition-all ease-in duration-125 bg-white dark:bg-gray-900 rounded-md group-hover:bg-transparent group-hover:dark:bg-transparent">
      <a href="" download="Jenson_Chua_Resume">Download</a>
    </span>
  </button>
</BaseLayout>
